# Trading target
SYMBOL=
TIMEFRAME_TREND=
TIMEFRAME_ENTRY=

# Risk controls
RISK_PERCENT=
MAX_POSITIONS=
CONFIDENCE_THRESHOLD=
CLOSE_CONFIDENCE_THRESHOLD=
MAX_DAILY_LOSS_PCT=
CONSECUTIVE_LOSS_LIMIT=

# SL/TP
ATR_MULTIPLIER_SL=
RISK_REWARD_RATIO=2.0
BREAKEVEN_BUFFER=
# 構造SL採用時にレベルの外側へ取るヒゲ抜けバッファ(USD、既定2.0=20pips)
SL_STRUCTURE_BUFFER_USD=

# Execution controls
NEWS_FILTER_MINUTES=
BREAKEVEN_MONITOR_TIMES=07,22,37,52
# Timezone of the economic calendar feed timestamps (IANA name, default UTC)
CALENDAR_TIMEZONE=
# NY time (HH:MM) from which open positions are force-closed on Fridays (default 16:30)
FRIDAY_FLAT_TIME_NY=
# NY time (HH:MM) from which unfilled pending orders are cancelled daily (Good For Day, default 16:45)
DAILY_PENDING_CUTOFF_NY=
# NY time (HH:MM) from which Monday judgments are allowed (default 08:00; before this Monday is paused)
MONDAY_OPEN_NY=
# Static USD/JPY rate used only when MT5 cannot provide a live rate
JPY_USD_RATE_FALLBACK=

# Models (defaults: analysis/debate=gpt-5.6-terra, decision=gpt-5.6-sol)
MODEL_ANALYSIS=
MODEL_DECISION=
MODEL_DEBATE=
MAX_NEWS_ITEMS=
STAGE=

# MT5 account
MT5_PATH=
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
# MT5サーバ時刻のタイムゾーン(IANA名)。XM系はEurope/Athens(EET/EEST)。未設定なら約定時刻を従来どおりUTC扱い
MT5_SERVER_TIMEZONE=

# API keys
OPENAI_API_KEY=
NEWS_API_KEY=
FRED_API_KEY=

# Gold-specific data sources (all optional; defaults work without keys)
# Comma-separated RSS feed URLs to override the built-in list (check with scripts/check_data_sources.py)
RSS_FEEDS=
# CFTC COT (Socrata) dataset URL and market name for the gold contract
COT_DATASET_URL=
COT_MARKET_NAME=
# GLD ETF flows (optional, off by default). Set to the SSGA 'SPDR Product Data' xlsx URL to enable
GLD_HOLDINGS_URL=
# Broker dollar-index symbol candidates (comma-separated); falls back to a synthetic index from major pairs
DXY_SYMBOL_CANDIDATES=
# Hours of past releases / upcoming events handed to the analysts (default 48 / 24)
RELEASES_LOOKBACK_HOURS=
EVENTS_LOOKAHEAD_HOURS=
